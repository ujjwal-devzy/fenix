<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreference
        android:defaultValue="true"
        android:key="@string/pref_key_tab_group_suggestions_enabled"
        android:title="@string/tab_group_suggestions_settings_toggle_title"
        android:summary="@string/tab_group_suggestions_settings_toggle_summary"
        app:iconSpaceReserved="false" />

    <Preference
        android:key="@string/pref_key_tab_group_suggestions_reset_dismissed"
        android:title="@string/tab_group_suggestions_settings_reset_dismissed_title"
        android:summary="@string/tab_group_suggestions_settings_reset_dismissed_summary"
        app:iconSpaceReserved="false" />
